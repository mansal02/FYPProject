# Copy this file to .env and adjust values for your local machine.
# Never commit your real .env file.

# Optional path to a custom YAML config file
MARIE_CONFIG_PATH=./config.yaml

# Runtime paths
MARIE_DB_PATH=./marie_data.db
MARIE_AUTO_LOGIN_FILE=./.marie_autologin.json
MARIE_DEFAULT_MODEL=./models/kei/runtime/kei_vowels_pro.model3.json

# Service endpoints
MARIE_REASONING_URL=http://127.0.0.1:8000/chat
MARIE_REASONING_STREAM_URL=http://127.0.0.1:8000/chat/stream
MARIE_REASONING_STOP_URL=http://127.0.0.1:8000/chat/stop
MARIE_VOICE_URL=http://127.0.0.1:8001/speak
MARIE_VOICE_STOP_URL=http://127.0.0.1:8001/stop

# Ollama
MARIE_OLLAMA_MODEL=llama3
MARIE_NUM_PREDICT=180
MARIE_NUM_CTX=2048
MARIE_TEMPERATURE=0.2
MARIE_SPEAKING_SPEED=1.0
MARIE_UI_THEME=dark

# Optional screen-share vision settings
MARIE_SCREEN_SHARE_ENABLED=0
MARIE_VISION_MODEL=
MARIE_SCREENSHOT_DIR=./cache/screens
MARIE_SCREEN_CAPTURE_INTERVAL_SEC=0.8
MARIE_SCREEN_MAX_WIDTH=1280

# Optional: local API keys or integration secrets
# MARIE_CUSTOM_API_KEY=
